# Copy this file to .env and change what you need. Every line is optional.

# Gemini writes the final answer from the retrieved passages.
# Leave it empty to run without an LLM: the app then answers with the best sentences from the documents.
# Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=
LLM_MODEL=gemini-flash-latest
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=30
LLM_MAX_ATTEMPTS=2

# Retrieval
# false = keyword search only (no model download)
SEMANTIC_SEARCH=true
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
USE_RERANKER=false
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
FINAL_TOP_K=5
# Word stemmer used for searching: snowball, porter, lancaster or none
STEMMER=snowball
# Second ranking: query likelihood with a smoothed language model (dirichlet, jelinek_mercer or laplace)
USE_LM_RETRIEVER=true
LM_SMOOTHING=dirichlet
LM_MU=120
# A Naive Bayes guess of which document the question belongs to nudges the ranking
USE_ROUTER=true
ROUTER_BOOST=0.5

# Chunking (in words). MiniLM only reads about 256 word pieces, so keep chunks small.
CHUNK_SIZE=170
CHUNK_OVERLAP=30

# "Not in your documents" check. Raise the numbers to refuse more, lower them to refuse less.
# Use the diagnostic script to see these values for a question: python scripts/check_question.py "..."
MIN_KNOWN_TERM_RATIO=0.5
MIN_TERM_COVERAGE=0.5
SEMANTIC_STRONG=0.60
SEMANTIC_FLOOR=0.20
MIN_STRENGTH_WITH_LLM=0.35
MIN_STRENGTH_WITHOUT_LLM=0.50

# OCR for scanned PDFs and image files: auto, rapidocr, tesseract or off
OCR_ENGINE=auto
OCR_DPI=200
OCR_MIN_PAGE_CHARS=80
OCR_IMAGE_AREA_RATIO=0.1
OCR_EMBEDDED_IMAGES=true

# Files and folders
DOCUMENTS_DIR=documents
STORAGE_DIR=storage
MAX_FILE_SIZE_MB=50
AUTO_INDEX_ON_STARTUP=true

# Server
API_HOST=127.0.0.1
API_PORT=8000
API_BASE_URL=http://127.0.0.1:8000
# Comma separated list, or * to allow any website to call the API
CORS_ALLOWED_ORIGINS=*
